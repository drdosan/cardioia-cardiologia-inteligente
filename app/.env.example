# CardioIA - Fase 5: copie este arquivo para .env e preencha com suas credenciais.
# O arquivo .env NAO deve ser commitado (ja esta no .gitignore).

# --- watsonx Assistant (IBM Cloud) ---
# Recurso -> Launch watsonx Assistant -> Assistant settings -> API details
WATSON_API_KEY=sua_api_key_aqui
WATSON_URL=https://api.us-south.assistant.watson.cloud.ibm.com/instances/xxxxxxxx
WATSON_ASSISTANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WATSON_VERSION=2021-11-27

# Opcional: so em planos com ambientes draft/live separados.
# No plano Lite deixe em branco - o assistant_id e usado como environment_id.
WATSON_ENVIRONMENT_ID=

# --- Aplicacao ---
HOST=127.0.0.1
PORTA=5000
DEBUG=True

# Use 1 para demonstrar o motor local mesmo com credenciais configuradas.
FORCAR_MOTOR_LOCAL=0
